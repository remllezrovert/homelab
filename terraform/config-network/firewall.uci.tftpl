# ---------------------------------------------------------------------------
# Generated by Terraform. Do not edit on OpenWrt.
#
# Source:
#   config-network/firewall.uci.tftpl
#
# Input:
#   ../terraform.tfvars -> subnets
# ---------------------------------------------------------------------------

config defaults
        option input 'REJECT'
        option output 'ACCEPT'
        option forward 'REJECT'
        option synflood_protect '1'

config zone 'lan'
        option name 'lan'
        list network 'lan'
        option input 'ACCEPT'
        option output 'ACCEPT'
        option forward 'REJECT'
        option masq '1'
        option mtu_fix '1'

%{ for name, subnet in subnets ~}
config zone '${name}'
        option name '${name}'
        list network '${name}'
        option input 'ACCEPT'
        option output 'ACCEPT'
        option forward 'REJECT'

config forwarding 'lan_to_${name}'
        option src 'lan'
        option dest '${name}'

%{ endfor ~}
